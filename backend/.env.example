# Backend configuration. Copy to .env (start.sh does this from dev.env for local use).
# ENVIRONMENT: development | local | test | staging | production. development and local are the
#   non-deployed modes; anything else requires a real JWT_SECRET_KEY and a CORS allow-list without "*".
ENVIRONMENT=production
# DEBUG: true exposes /docs and /openapi.json. Default false.
DEBUG=false
# DATABASE_URL (default sqlite:///./app.db). PostgreSQL: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./app.db
# JWT_SECRET_KEY (required outside development/local, 32+ chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-generated-secret-of-at-least-32-characters
# CORS_ORIGINS: comma-separated explicit origins (credentialed CORS; no wildcard).
CORS_ORIGINS=http://localhost:5173
# SEED_ENABLED: load synthetic demo data (idempotent). Never enable against real data.
SEED_ENABLED=false
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# OTEL_EXPORTER_ENDPOINT: optional OTLP collector URL; tracing is additive and failures never block reads.
OTEL_EXPORTER_ENDPOINT=
