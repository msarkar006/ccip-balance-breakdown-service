# Root reference for every variable. Local runs read backend/.env (start.sh copies backend/dev.env once).
# The frontend needs none: it calls a relative /api. Never set VITE_API_URL.

# ENVIRONMENT (required in deployments; default production). development | local | test are non-deployed modes.
ENVIRONMENT=development
# DEBUG (default false). true exposes /docs and /openapi.json.
DEBUG=false
# DATABASE_URL (default sqlite:///./app.db). Containers/staging/prod: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./app.db
# JWT_SECRET_KEY (required, 32+ chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-generated-secret-of-at-least-32-characters
# CORS_ORIGINS (default http://localhost:5173). Comma-separated explicit origins; "*" is rejected.
CORS_ORIGINS=http://localhost:5173
# SEED_ENABLED (default false). true loads idempotent synthetic demo data. Never enable on real data.
SEED_ENABLED=false
# LOG_LEVEL (default INFO). DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# OTEL_EXPORTER_ENDPOINT (optional). OTLP collector URL from your platform team; failures never block reads.
OTEL_EXPORTER_ENDPOINT=
# POSTGRES_PASSWORD (docker-compose.postgres.yml only; default ccip-local-password). Choose any strong value.
POSTGRES_PASSWORD=
# BACKEND_PORT / PORT (optional, local scripts). Vite proxy target port (default 9000) / listen port.
